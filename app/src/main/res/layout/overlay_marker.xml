<?xml version="1.0" encoding="utf-8"?>
<!-- Numbered point marker: a circular badge with a centered white number. Root
     wrapper keeps the fixed size when inflated with a null parent. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/marker_label"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_marker_dot"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />
</FrameLayout>
